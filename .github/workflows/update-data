name: Update CBAM data

on:
  schedule:
    - cron: "30 10 * * 1-5"   # weekdays, 10:30 UTC
  workflow_dispatch: {}        # "Run workflow" button

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -r requirements.txt
      - name: Refresh live prices (UK rate from GOV.UK, EU carbon price)
        id: upd
        run: |
          set +e
          python update_data.py
          echo "rc=$?" >> "$GITHUB_OUTPUT"
      - name: Commit if data.json changed
        run: |
          git config user.name "cbam-bot"
          git config user.email "cbam-bot@users.noreply.github.com"
          git add docs/data.json
          git diff --cached --quiet || (git commit -m "Update CBAM data" && git push)
      - name: Fail the run if the updater raised a warning (so you get an email)
        if: steps.upd.outputs.rc != '0'
        run: exit 1
